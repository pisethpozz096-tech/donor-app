            <p class="moul-text fw-bold small">ប្រធានគណៈកម្មការសាលារៀន</p>
          </div>
          <div class="col-4 text-center">
            <p class="mb-1 small">យ៉ាដាវ ថ្ងៃទី ..... ខែ ...... ឆ្នាំ ២០២...</p>
            <p class="moul-text fw-bold small">ហិរញ្ញឹក/អ្នកធ្វើតារាង</p>
          </div>
        </div>
      </div>
    `;

    const pages = [];
    const totalItems = list.length;

    if (totalItems <= 22) {
      pages.push(list);
    } else {
      let p1Limit = 22;
      let otherLimit = 22;
      if (totalItems >= 23 && totalItems <= 26) {
        p1Limit = totalItems - 1;
      } else if (totalItems > 26) {
        p1Limit = 25;
      }
      pages.push(list.slice(0, p1Limit));
      let currentIndex = p1Limit;
      while (currentIndex < totalItems) {
        pages.push(list.slice(currentIndex, currentIndex + otherLimit));
        currentIndex += otherLimit;
      }
    }

    const totalPages = pages.length;

    let grandKHR = 0, grandUSD = 0, grandEstKHR = 0, grandEstUSD = 0;
