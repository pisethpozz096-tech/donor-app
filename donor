  const saks = ["ឯកស័ក", "ទោស័ក", "ត្រីស័ក", "ចត្វាស័ក", "បញ្ចស័ក", "ឆស័ក", "សប្តស័ក", "អដ្ឋស័ក", "នព្វស័ក", "សំរឹទ្ធិស័ក"];

  function toKhmerNum(num) {
    return num.toString().split('').map(n => khmerNumbers[n] || n).join('');
  }

  function getKhmerYearAndSak(date) {
    const gYear = date.getFullYear();
    const m = date.getMonth() + 1;
    const d = date.getDate();
    const isAfterKNY = (m > 4) || (m === 4 && d >= 14);
    const khmerYear = isAfterKNY ? gYear : gYear - 1;

    let animalIdx = (khmerYear - 2020 + 0) % 12;
    if (animalIdx < 0) animalIdx += 12;

    let sakIdx = (khmerYear - 2026 + 7) % 10;
    if (sakIdx < 0) sakIdx += 10;

    const beYear = khmerYear + 544;
    return { animal: animalYears[animalIdx], sak: saks[sakIdx], be: beYear };
  }

  function calculateKhmerLunar(d) {
    const dayName = khmerDays[d.getDay()];
    const refDate = new Date(2024, 0, 11);
    const diffDays = (d.getTime() - refDate.getTime()) / (1000 * 3600 * 24);
    let cycle = (diffDays % 29.530588 + 29.530588) % 29.530588;
    let dayNum = Math.floor(cycle) + 1;
    let phase = (dayNum <= 15) ? `${toKhmerNum(dayNum)}កើត` : `${toKhmerNum(dayNum - 15)}រោច`;
    let mIdx = (d.getMonth() + (d.getDate() >= 12 ? 0 : 11)) % 12;
    let lunarMonth = lunarMonths[mIdx];
    const yearData = getKhmerYearAndSak(d);
    return `ថ្ងៃ${dayName} ${phase} ខែ${lunarMonth} ឆ្នាំ${yearData.animal} ${yearData.sak} ព.ស. ${toKhmerNum(yearData.be)}`;
  }

