    :root {
      --page-bg: #f4f6f9;
      --surface: #ffffff;
      --surface-2: #f8fafc;
      --ink: #26313f;
      --ink-soft: #64748b;
      --line: #e2e8f0;
      --brand-1: #1e3c72;
      --brand-2: #2a5298;
      --shadow: rgba(0,0,0,0.06);
    }
    html[data-bs-theme="dark"] {
      --page-bg: #0f1521;
      --surface: #161e2c;
      --surface-2: #1b2434;
      --ink: #e6ebf2;
      --ink-soft: #93a0b4;
      --line: #2b3a52;
      --brand-1: #16294d;
      --brand-2: #1e3c72;
      --shadow: rgba(0,0,0,0.35);

      color-scheme: dark;
      --bs-body-bg: var(--page-bg);
      --bs-body-color: var(--ink);
    }
    html[data-bs-theme="dark"] body { background-color: var(--page-bg); color: var(--ink); }
    html[data-bs-theme="dark"] .card,
    html[data-bs-theme="dark"] .list-group-item,
    html[data-bs-theme="dark"] .modal-content,
    html[data-bs-theme="dark"] table {
      background-color: var(--surface); color: var(--ink); border-color: var(--line);
    }
    html[data-bs-theme="dark"] .table { --bs-table-bg: var(--surface); --bs-table-color: var(--ink); --bs-table-border-color: var(--line); }
    html[data-bs-theme="dark"] .text-muted { color: var(--ink-soft) !important; }
    html[data-bs-theme="dark"] .bg-light { background-color: var(--surface-2) !important; color: var(--ink); }
    html[data-bs-theme="dark"] .border,
    html[data-bs-theme="dark"] .border-bottom,
    html[data-bs-theme="dark"] .border-top { border-color: var(--line) !important; }
    html[data-bs-theme="dark"] .form-control,
    html[data-bs-theme="dark"] .form-select {
      background-color: var(--surface-2); color: var(--ink); border-color: var(--line);
    }
    html[data-bs-theme="dark"] .form-control::placeholder { color: var(--ink-soft); }
    html[data-bs-theme="dark"] .form-control:focus,
    html[data-bs-theme="dark"] .form-select:focus {
      background-color: var(--surface-2); color: var(--ink);
    }
    html[data-bs-theme="dark"] .media-upload-card {
      background: var(--surface); border-color: var(--line);
    }
    html[data-bs-theme="dark"] .media-label-title { color: var(--ink); }
    html[data-bs-theme="dark"] .custom-file-upload-wrapper {
      background: var(--surface-2); border-color: var(--line);
    }
    html[data-bs-theme="dark"] .custom-file-upload-wrapper:hover { background: var(--line); }
    html[data-bs-theme="dark"] .file-upload-text { color: var(--ink-soft); }
    html[data-bs-theme="dark"] .file-upload-icon-btn { background: var(--line); color: var(--ink); }
    html[data-bs-theme="dark"] .badge.bg-light { background-color: var(--surface-2) !important; color: var(--ink-soft) !important; }
    html[data-bs-theme="dark"] .btn-outline-primary,
