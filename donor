  function setupYearFilter() {
    const yearSelect = document.getElementById('filter-year');
    const currentYear = new Date().getFullYear();
    yearSelect.innerHTML = '<option value="">-- គ្រប់ឆ្នាំ --</option>';
    for (let y = currentYear; y >= currentYear - 5; y--) {
      yearSelect.innerHTML += `<option value="${y}">${y}</option>`;
    }
  }

  function applyReportFilter() {
    const year = document.getElementById('filter-year').value;
    const semester = document.getElementById('filter-semester').value;
    const month = document.getElementById('filter-month').value;

    currentFilteredList = globalData.filter(item => {
      if (!item.date) return false;
      const d = new Date(item.date);
      const itemYear = d.getFullYear().toString();
      const itemMonth = (d.getMonth() + 1).toString().padStart(2, '0');

      if (year && itemYear !== year) return false;
      if (month && itemMonth !== month) return false;
      if (semester) {
        const m = d.getMonth() + 1;
        if (semester === '1' && (m < 1 || m > 6)) return false;
        if (semester === '2' && (m < 7 || m > 12)) return false;
      }
      return true;
    });

    renderReportTable(currentFilteredList);
  }

