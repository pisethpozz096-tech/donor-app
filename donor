  <script>
    /* ====== ជំហានតែមួយគត់ដែលត្រូវកែ: ដាក់ URL /exec របស់ Apps Script ក្នុងសញ្ញា " " ខាងក្រោម ====== */
    var API_URL = "PASTE_YOUR_EXEC_URL_HERE";
    /* ================================================================================ */

    // Replaces google.script.run (only exists inside Apps Script) with fetch() calls to the Apps Script API.
    (function () {
      function runner(ok, bad) {
        return new Proxy({}, {
          get: function (_, name) {
            if (typeof name !== 'string') return undefined;
            if (name === 'withSuccessHandler') return function (f) { return runner(f, bad); };
            if (name === 'withFailureHandler') return function (f) { return runner(ok, f); };
            return function () {
              var args = Array.prototype.slice.call(arguments);
              var fail = function (m) { if (bad) bad(new Error(m)); else console.error(m); };
              if (/PASTE_YOUR/.test(API_URL)) return fail('មិនទាន់ដាក់ API_URL ក្នុង index.html');
              // text/plain keeps this a "simple" request, so the browser sends no CORS preflight (Apps Script cannot answer one)
              fetch(API_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                               body: JSON.stringify({ fn: name, args: args }), redirect: 'follow' })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                  if (res && res.error) return fail(res.error);
                  if (ok) ok(res ? res.result : undefined);
                }, function (e) { fail('ការតភ្ជាប់បរាជ័យ: ' + e.message); });
            };
          }
        });
      }
      window.google = { script: { run: runner(null, null), url: { getLocation: function (cb) { cb({ hash: '' }); } } } };
    })();
  </script>
