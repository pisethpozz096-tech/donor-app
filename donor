<script>
  let sessionToken = '';
  const UI_BUILD = 'u8';
  const SERVER_BUILD = 'github';
  (function showVersion() {
    var v = document.getElementById('ver-tag');
    if (v) v.textContent = 'UI ' + UI_BUILD + ' · Server ' + (SERVER_BUILD || 'ចាស់');
  })();
  let currentUser = null;
  let globalData = [];
  let currentFilteredList = [];

  function updateThemeIcon(theme) {
    const icon = document.getElementById('themeToggleIcon');
    if (icon) icon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
  }
  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-bs-theme', next);
    try { localStorage.setItem('ydv-theme', next); } catch (e) {}
    updateThemeIcon(next);
  }
  updateThemeIcon(document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'dark' : 'light');

  document.getElementById('loginForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const u = document.getElementById('login-username').value;
    const p = document.getElementById('login-password').value;

    Swal.fire({
      title: 'កំពុងផ្ទៀងផ្ទាត់...',
      allowOutsideClick: false,
      didOpen: () => Swal.showLoading()
    });

    if (typeof google !== 'undefined' && google.script && google.script.run) {
      google.script.run
        .withSuccessHandler(function(res) {
          if (res && res.success) {
            currentUser = res.user;
            sessionToken = res.token;
            Swal.fire({
              icon: 'success',
              title: 'ជោគជ័យ!',
              text: 'សូមស្វាគមន៍ ' + currentUser.name,
              timer: 1200,
              showConfirmButton: false
            });
            showApp();
          } else {
            Swal.fire({ icon: 'error', title: 'បរាជ័យ!', text: (res ? res.message : 'គណនី ឬលេខសម្ងាត់មិនត្រឹមត្រូវ') });
          }
        })
        .withFailureHandler(function(err) {
          Swal.fire({ icon: 'error', title: 'មានបញ្ហា!', text: 'មិនអាចតភ្ជាប់ទៅ Server ៖ ' + err.message });
        })
        .checkLogin(u, p);
    } else {
      currentUser = { name: u || 'Admin User', role: 'Admin' };
      Swal.fire({ icon: 'success', title: 'ជោគជ័យ (Demo Mode)', timer: 1000, showConfirmButton: false });
      showApp();
    }
  });

  function logout() {
    try { if (hasGoogleRun() && sessionToken) google.script.run.logout(sessionToken); } catch (e) {}
    sessionToken = '';
    currentUser = null;
    document.getElementById('app-container').style.display = 'none';
    document.getElementById('login-page').style.display = 'flex';
    document.getElementById('login-username').value = '';
    document.getElementById('login-password').value = '';
  }

  function showApp() {
    document.getElementById('login-page').style.display = 'none';
    document.getElementById('app-container').style.display = 'block';

    document.getElementById('user-display-name').innerText = currentUser.name;
    document.getElementById('user-display-role').innerText = (currentUser.role === 'Admin') ? 'អ្នកគ្រប់គ្រង (Admin)' : 'អ្នកវាយទិន្នន័យ';
    // Report & thank-you letters are Admin-only; data-entry users never see them
    ['btn-report', 'btn-letter'].forEach(function (id) {
      var li = document.getElementById(id).closest('li');
      if (li) li.style.display = (currentUser.role === 'Admin') ? '' : 'none';
    });

    setupYearFilter();
    document.getElementById('date').value = new Date().toISOString().split('T')[0];
    
    loadHelpTypes();
    loadAllData();
    restoreSidebarState();

    switchTab('dashboard');
  }

  function switchTab(tab) {
    if ((tab === 'report' || tab === 'letter') && (!currentUser || currentUser.role !== 'Admin')) tab = 'dashboard';
    document.getElementById('section-dashboard').style.display = (tab === 'dashboard') ? 'block' : 'none';
    document.getElementById('section-form').style.display = (tab === 'form') ? 'block' : 'none';
    document.getElementById('section-report').style.display = (tab === 'report') ? 'block' : 'none';
    document.getElementById('section-letter').style.display = (tab === 'letter') ? 'block' : 'none';

    document.getElementById('btn-dashboard').classList.toggle('active', tab === 'dashboard');
    document.getElementById('btn-form').classList.toggle('active', tab === 'form');
    document.getElementById('btn-report').classList.toggle('active', tab === 'report');
    document.getElementById('btn-letter').classList.toggle('active', tab === 'letter');

    if (tab === 'letter') {
      pullLetterSheet(currentContentType());
      populateLetterDonorSelect();
    }
