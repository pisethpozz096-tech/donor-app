  function editItem(id) {
    const item = globalData.find(d => d.id === id);
    if (!item) return;

    document.getElementById('edit-id').value = item.id;
    document.getElementById('date').value = item.date;
    document.getElementById('name').value = item.name;
    document.getElementById('source').value = item.source;
    document.getElementById('helpTypeFromSheet').value = item.helpTypeFromSheet;
    document.getElementById('type').value = item.type;

    toggleHelpTypeFields();

    document.getElementById('amountRiel').value = item.amountRiel;
    document.getElementById('amountUsd').value = item.amountUsd;
    document.getElementById('itemName').value = item.itemName;
