  const khTens = { 1: 'ដប់', 2: 'ម្ភៃ', 3: 'សាមសិប', 4: 'សែសិប', 5: 'ហាសិប', 6: 'ហុកសិប', 7: 'ចិតសិប', 8: 'ប៉ែតសិប', 9: 'កៅសិប' };

  function khReadUnder1000(n) {
    if (n <= 0) return '';
    const hundreds = Math.floor(n / 100);
    const rem = n % 100;
    let parts = [];
    if (hundreds > 0) parts.push(khOnes[hundreds] + 'រយ');
    if (rem > 0) {
      const tens = Math.floor(rem / 10);
      const unit = rem % 10;
      if (tens > 0) {
        parts.push(khTens[tens] + (unit > 0 ? khOnes[unit] : ''));
      } else {
        parts.push(khOnes[unit]);
      }
    }
    return parts.join('');
  }

  function khReadBelowMillion(n) {
    if (n <= 0) return '';
    const senn = Math.floor(n / 100000);
    const remA = n % 100000;
    const muen = Math.floor(remA / 10000);
    const remB = remA % 10000;
    const poan = Math.floor(remB / 1000);
    const remC = remB % 1000;

    let parts = [];
    if (senn > 0) parts.push(khOnes[senn] + 'សែន');
    if (muen > 0) parts.push(khOnes[muen] + 'ម៉ឺន');
    if (poan > 0) parts.push(khOnes[poan] + 'ពាន់');
    if (remC > 0) parts.push(khReadUnder1000(remC));
    return parts.join('');
  }

  function khReadNumber(n) {
    n = Math.floor(Math.abs(Number(n) || 0));
    if (n === 0) return 'សូន្យ';
    if (n < 1000000) return khReadBelowMillion(n);

    const millions = Math.floor(n / 1000000);
    const remainder = n % 1000000;
    return khReadNumber(millions) + 'លាន' + (remainder > 0 ? khReadBelowMillion(remainder) : '');
  }

  function khRielWords(amount) {
    return khReadNumber(amount) + 'រៀល';
  }

  function khUsdWords(amount) {
    const dollars = Math.floor(amount);
    const cents = Math.round((amount - dollars) * 100);
    let words = khReadNumber(dollars) + 'ដុល្លារ';
    if (cents > 0) words += ' និង ' + khReadNumber(cents) + 'សេន';
    return words;
  }

