  function formatLetterDates(dateVal, schoolName) {
    if (!dateVal) return { solar: '', lunar: '' };
    const parts = dateVal.split('-');
    const date = new Date(parts[0], parts[1] - 1, parts[2]);
    return {
      solar: `${schoolName} ថ្ងៃទី${toKhmerNum(date.getDate())} ខែ${khmerMonths[date.getMonth()]} ឆ្នាំ${toKhmerNum(date.getFullYear())}`,
      lunar: calculateKhmerLunar(date)
    };
  }

  // ប្រមូលទិន្នន័យនាំចូលពីគ្រប់ប្រភេទលិខិតទាំងអស់យ៉ាងត្រឹមត្រូវ
  function allImportedRecords() {
    let list = [];
    Object.keys(importedRecords).forEach(t => {
      if (Array.isArray(importedRecords[t])) list = list.concat(importedRecords[t]);
      if (Array.isArray(sampleRecords[t])) list = list.concat(sampleRecords[t]);
    });
    return list;
  }

  // មុខងារស្វែងរកកំណត់ត្រាទាំងក្នុង globalData និងគ្រប់ប្រភេទ importedRecords ទាំងអស់
  function findRecord(id) {
    if (!id) return null;
    let found = globalData.find(d => d.id === id);
    if (found) return found;
    return allImportedRecords().find(d => d.id === id) || null;
  }

  function getActiveRecords() {
    const t = currentContentType();
    const samples = sampleRecords[t] || [];
    if (t === 'appreciation') {
      return samples.concat(globalData.slice().reverse(), importedRecords[t] || []);
    }
    return (importedRecords[t] || []).concat(samples);
  }

