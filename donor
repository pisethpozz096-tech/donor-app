  const FIELD_ORDER = ['itemName', 'itemQty', 'itemUnit', 'amountRiel', 'amountUsd', 'sponsorDetails', 'purpose', 'regNo', 'date', 'phone', 'note', 'gender', 'seq', 'name'];

  function normHeader(s) {
    return String(s == null ? '' : s)
      .toLowerCase()
      .replace(/[\u200B-\u200D\uFEFF\u17C8]/g, '')
      .replace(/[\s_\-\/\\()\[\]{}:;,.\u00B7\u2022\u17D4\u17D6*]+/g, '');
  }

  const ALIAS_NORM = {};
  Object.keys(FIELD_ALIASES).forEach(f => { ALIAS_NORM[f] = FIELD_ALIASES[f].map(normHeader); });

  function matchField(h) {
    if (!h) return null;
    for (const f of FIELD_ORDER) if (ALIAS_NORM[f].includes(h)) return f;
    let best = null, bestLen = 0;
    for (const f of FIELD_ORDER) {
      for (const a of ALIAS_NORM[f]) {
        if (a.length >= 6 && h.includes(a) && a.length > bestLen) { best = f; bestLen = a.length; }
      }
    }
    return best;
  }

  function detectHeader(rows) {
    let best = null;
    for (let r = 0; r < Math.min(rows.length, 10); r++) {
      const row = rows[r] || [];
      const map = {};
      row.forEach((cell, c) => {
        const f = matchField(normHeader(cell));
        if (f && map[f] === undefined) map[f] = c;
      });
      const score = Object.keys(map).length;
      if (map.name !== undefined && (!best || score > best.score)) best = { headerRow: r, map, score };
    }
    return best;
  }

  const KH_DIGITS = { '០': '0', '១': '1', '២': '2', '៣': '3', '៤': '4', '៥': '5', '៦': '6', '៧': '7', '៨': '8', '៩': '9' };
  function parseAmount(v) {
    if (v === '' || v == null) return 0;
    const s = String(v).replace(/[០-៩]/g, d => KH_DIGITS[d]).replace(/[^0-9.\-]/g, '');
    const n = parseFloat(s);
    return isFinite(n) ? n : 0;
  }

  function sheetToRecords(rows, type, sheetName) {
    const det = detectHeader(rows || []);
    if (!det) return { records: [], fields: [], error: 'no-name' };

    const records = [];
    for (let r = det.headerRow + 1; r < rows.length; r++) {
      const row = rows[r] || [];
      const get = f => (det.map[f] === undefined || row[det.map[f]] == null) ? '' : String(row[det.map[f]]).trim();
      const name = get('name');
      if (!name) continue;

      const amountRiel = parseAmount(get('amountRiel'));
      const amountUsd = parseAmount(get('amountUsd'));
      const itemName = get('itemName');
      const hasCash = amountRiel > 0 || amountUsd > 0;

      records.push({
        id: '',
        date: get('date'),
        name: name,
        source: 'នាំចូល',
        helpTypeFromSheet: get('purpose'),
        type: hasCash ? (itemName ? 'ទាំងពីរ' : 'សាច់ប្រាក់') : (itemName ? 'សម្ភារ' : ''),
        amountRiel: amountRiel || '',
        amountUsd: amountUsd || '',
        itemName: itemName,
        itemQty: get('itemQty'),
        itemUnit: get('itemUnit'),
        phone: get('phone'),
        note: get('note'),
        regNo: get('regNo'),
        sponsorText: get('sponsorDetails'),
        gender: get('gender'),
        seq: get('seq'),
        _imported: true,
        _type: type,
        _row: r + 1,
        _sheet: sheetName
      });
    }
    const fields = Object.keys(det.map).sort((a, b) => det.map[a] - det.map[b]);
    return { records, fields, error: '' };
  }

  function guessType(sheetName, onlyOne) {
    const keys = Object.keys(contentPresets);
    for (const t of keys) if (t !== 'appreciation' && contentPresets[t].sheetHint.test(sheetName)) return t;
    const cur = currentContentType();
    return (onlyOne && cur !== 'appreciation') ? cur : '';
  }

  function loadPendingFromSheets(sheetMap, sourceLabel) {
    const names = Object.keys(sheetMap);
    pendingSourceLabel = sourceLabel;
    pendingSheets = names.map(n => {
      const info = sheetToRecords(sheetMap[n], '', n);
      return {
        name: n,
        rows: sheetMap[n],
        type: info.error ? '' : guessType(n, names.length === 1),
        count: info.records.length,
        fields: info.fields,
        error: info.error
      };
    });
    renderPendingTable();
  }

  function renderPendingTable() {
    const box = document.getElementById('pendingSheetsBox');
    if (!box) return;
    if (!pendingSheets.length) { box.style.display = 'none'; box.innerHTML = ''; return; }

    const typeOptions = i => '<option value="">— មិននាំចូល —</option>' + Object.keys(contentPresets).filter(t => t !== 'appreciation').map(t =>
      `<option value="${t}" ${pendingSheets[i].type === t ? 'selected' : ''}>${esc(contentPresets[t].title)}</option>`).join('');

    const rowsHtml = pendingSheets.map((p, i) => {
      const cols = p.error
        ? '<span class="badge bg-danger field-badge">រកមិនឃើញជួរឈរ “ឈ្មោះ”</span>'
        : p.fields.map(f => `<span class="badge bg-light text-dark border field-badge">${FIELD_LABELS[f]}</span>`).join('');
      return `<tr>
        <td class="fw-bold">${esc(p.name)}</td>
        <td class="text-center">${p.count}</td>
        <td>${cols}</td>
        <td><select class="form-select form-select-sm" onchange="setPendingType(${i}, this.value)" ${p.error ? 'disabled' : ''}>${typeOptions(i)}</select></td>
      </tr>`;
    }).join('');

    const ready = pendingSheets.some(p => p.type && !p.error && p.count > 0);
    box.innerHTML = `
      <div class="border rounded p-2 bg-light">
        <div class="small fw-bold mb-2"><i class="fa-solid fa-table-list me-1"></i> ប្រភព៖ ${esc(pendingSourceLabel)} — រកឃើញ ${pendingSheets.length} Sheet សូមជ្រើសប្រភេទលិខិតឱ្យ Sheet នីមួយៗ</div>
        <div class="table-responsive">
          <table class="table table-sm table-bordered bg-white mb-2 sheet-map-table">
            <thead class="table-light"><tr><th>ឈ្មោះ Sheet</th><th class="text-center">ចំនួនជួរ</th><th>ជួរឈរដែលស្គាល់</th><th>ប្រភេទលិខិត</th></tr></thead>
            <tbody>${rowsHtml}</tbody>
          </table>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-primary btn-sm" onclick="applyImport()" ${ready ? '' : 'disabled'}><i class="fa-solid fa-check me-1"></i> នាំចូលទិន្នន័យ</button>
          <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cancelPending()">បោះបង់</button>
        </div>
      </div>`;
    box.style.display = 'block';
  }

  function setPendingType(i, v) {
    if (pendingSheets[i]) pendingSheets[i].type = v;
    renderPendingTable();
  }

  function cancelPending() {
    pendingSheets = [];
    const inp = document.getElementById('importFile'); if (inp) inp.value = '';
    const nm = document.getElementById('importFileName');
    if (nm) { nm.innerText = 'ជ្រើសរើសឯកសារ Excel / CSV (.xlsx .xls .csv)...'; nm.style.color = '#64748b'; nm.style.fontWeight = 'normal'; }
    renderPendingTable();
  }

  function applyImport() {
    const perType = {};
    pendingSheets.forEach(p => {
      if (!p.type || p.error || !p.count) return;
      const res = sheetToRecords(p.rows, p.type, p.name);
      res.records.forEach(r => { r.id = `sheet_${p.type}_${r._row}`; });
      const bucket = perType[p.type] || (perType[p.type] = { records: [], sheets: [] });
      bucket.records = bucket.records.concat(res.records);
      bucket.sheets.push(p.name);
    });

    const touched = Object.keys(perType);
    if (!touched.length) {
      Swal.fire({ icon: 'warning', title: 'មិនមានអ្វីត្រូវនាំចូល', text: 'សូមជ្រើសប្រភេទលិខិតឱ្យ Sheet យ៉ាងតិចមួយ ដែលមានជួរឈរ “ឈ្មោះ”។' });
      return;
    }

    const sheetsToPersist = pendingSheets.filter(p => p.type && !p.error && p.count);

    touched.forEach(t => {
      importedRecords[t] = perType[t].records;
      importedMeta[t] = perType[t].sheets;
    });

    const sel = document.getElementById('contentTypeSelect');
    const cur = currentContentType();
    const target = perType[cur] ? cur : ((importedRecords[cur] || []).length ? cur : touched[0]);
    if (perType[target]) selectedDonorIds = [];
    sel.value = target;

    const lines = touched.map(t => `<li>${esc(contentPresets[t].title)} ៖ <b>${perType[t].records.length}</b> ជួរ (${esc(perType[t].sheets.join(', '))})</li>`).join('');
    cancelPending();
    changeContentPreset(target);

    Swal.fire({ icon: 'success', title: 'នាំចូលជោគជ័យ', html: `<ul class="text-start small mb-0">${lines}</ul>`, confirmButtonText: 'យល់ព្រម' });

    persistImportedSheetsToGoogleSheet(sheetsToPersist);
  }

  async function persistImportedSheetsToGoogleSheet(sheetsToPersist) {
    if (!hasGoogleRun() || !sheetsToPersist || !sheetsToPersist.length) return;
    const results = [];
    for (const p of sheetsToPersist) {
      const destSheet = contentPresets[p.type].title;
      try {
        await gsCall('saveContentSheetRows', destSheet, p.rows, 'replace');
        await pullLetterSheet(p.type, { force: true, keepIfEmpty: true });
        results.push(`✔ ${esc(destSheet)}`);
      } catch (err) {
        results.push(`✖ ${esc(destSheet)}: ${esc((err && err.message) || err)}`);
      }
    }
    Swal.fire({
      icon: 'info', title: 'ស្ថានភាពការរក្សាទុកទៅ Google Sheet',
      html: '<div class="small text-start mb-0">' + results.join('<br>') + '</div>',
      confirmButtonText: 'យល់ព្រម'
    });
  }

  function handleImportFile(input) {
    const file = input.files && input.files[0];
    if (!file) return;

    if (typeof XLSX === 'undefined') {
      Swal.fire({ icon: 'error', title: 'មិនអាចអានឯកសារបាន', text: 'បណ្ណាល័យ SheetJS មិនទាន់ផ្ទុក។ សូមពិនិត្យអ៊ីនធឺណិត ហើយផ្ទុកទំព័រឡើងវិញ។' });
      input.value = '';
      return;
    }

    const nm = document.getElementById('importFileName');
    if (nm) { nm.innerText = file.name; nm.style.color = '#0f172a'; nm.style.fontWeight = '600'; }

    const isCsv = /\.csv$/i.test(file.name);
    const reader = new FileReader();
    reader.onload = function (e) {
      try {
        const wb = XLSX.read(e.target.result, { type: isCsv ? 'string' : 'array' });
        const map = {};
        wb.SheetNames.forEach(n => {
          const rows = XLSX.utils.sheet_to_json(wb.Sheets[n], { header: 1, defval: '', raw: false, blankrows: false });
          const key = isCsv ? file.name.replace(/\.csv$/i, '') : n;
          map[key] = rows;
        });
        loadPendingFromSheets(map, file.name);
      } catch (err) {
        Swal.fire({ icon: 'error', title: 'អានឯកសារមិនបាន', text: (err && err.message) || String(err) });
      }
    };
    reader.onerror = function () {
      Swal.fire({ icon: 'error', title: 'អានឯកសារមិនបាន', text: 'សូមសាកល្បងឯកសារផ្សេង។' });
    };
    if (isCsv) reader.readAsText(file, 'UTF-8'); else reader.readAsArrayBuffer(file);
  }

  function hasGoogleRun() {
    return typeof google !== 'undefined' && google.script && google.script.run;
  }

  function gsCall(fn) {
    const args = Array.prototype.slice.call(arguments, 1);
    return new Promise((resolve, reject) => {
      if (!hasGoogleRun()) { reject(new Error('មិនមានការតភ្ជាប់ទៅ Google Apps Script (Demo Mode)')); return; }
      args.push(sessionToken);
      google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[fn].apply(null, args);
    });
  }

  async function pullFromGoogleSheets() {
    Swal.fire({ title: 'កំពុងទាញទិន្នន័យពី Google Sheet...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
    try {
      const names = await gsCall('getContentSheetNames');
      if (!Array.isArray(names) || !names.length) throw new Error('រកមិនឃើញ Sheet លិខិត (ឈ្មោះ Sheet ត្រូវចាប់ផ្តើមដោយ “លិខិត”)');
      const map = {};
      for (const n of names) map[n] = await gsCall('getSheetRows', n);
      Swal.close();
      loadPendingFromSheets(map, 'Google Sheet');
    } catch (err) {
      Swal.fire({
        icon: 'error',
        title: 'ទាញទិន្នន័យមិនបាន',
        html: 'សូមបន្ថែមអនុគមន៍ <code>getContentSheetNames</code> និង <code>getSheetRows</code> ក្នុង Apps Script (មើលឯកសារ Code-sheets.gs)<br><small class="text-muted">' + esc((err && err.message) || err) + '</small>'
      });
    }
  }

  function downloadImportTemplate() {
    if (typeof XLSX === 'undefined') {
      Swal.fire({ icon: 'error', title: 'មិនអាចបង្កើតឯកសារបាន', text: 'បណ្ណាល័យ SheetJS មិនទាន់ផ្ទុក។ សូមពិនិត្យអ៊ីនធឺណិត។' });
      return;
    }
    const wb = XLSX.utils.book_new();
    const colWidths = [{ wch: 6 }, { wch: 26 }, { wch: 12 }, { wch: 46 }, { wch: 28 }, { wch: 14 }];

    const commendation = contentPresets.commendation;
    if (commendation) {
      const header = ['ល.រ', 'គោត្តនាមនិងនាម', 'ភេទ', 'ការបំពេញការងារ', 'គោលបំណង', 'លេខចុះបញ្ជី'];
      const sample = [1, 'ឈ្មោះអ្នកទទួលបាន', 'ប្រុស/ស្រី', commendation.sponsorDetails, commendation.purpose, commendation.regNo];
      const ws = XLSX.utils.aoa_to_sheet([header, sample]);
      ws['!cols'] = colWidths;
      XLSX.utils.book_append_sheet(wb, ws, commendation.title);
    }

    const honor = contentPresets.honor;
    if (honor) {
      const header = ['ល.រ', 'គោត្តនាមនិងនាម', 'ភេទ', 'ការបំពេញភារកិច្ច', 'គោលបំណង', 'លេខចុះបញ្ជី'];
      const sample = [1, 'ឈ្មោះអ្នកទទួលបាន', 'ប្រុស/ស្រី', honor.sponsorDetails, honor.purpose, honor.regNo];
      const ws = XLSX.utils.aoa_to_sheet([header, sample]);
      ws['!cols'] = colWidths;
      XLSX.utils.book_append_sheet(wb, ws, honor.title);
    }

    XLSX.writeFile(wb, 'គំរូនាំចូលលិខិត.xlsx');
  }

  function addSampleRecord() {
    const type = currentContentType();
    const p = contentPresets[type];
    if ((sampleRecords[type] || []).length) {
      Swal.fire({ icon: 'info', title: 'មានទិន្នន័យគំរូរួចហើយ', timer: 1400, showConfirmButton: false });
      return;
    }
    sampleRecords[type].push({
      id: `sample_${type}`, date: '', name: p.donorName, source: 'គំរូ',
      helpTypeFromSheet: p.purpose, type: '', amountRiel: '', amountUsd: '', itemName: '', itemQty: '', itemUnit: '',
      phone: '', note: '', regNo: p.regNo, sponsorText: p.sponsorDetails,
      _imported: true, _sample: true, _type: type, _sheet: '(ទិន្នន័យគំរូ)'
    });
    syncSourceUI();
    populateLetterDonorSelect();
    updateAllLetterPreviews();
  }

  window.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('btnPullGSheet');
    if (btn && !hasGoogleRun()) {
      btn.disabled = true;
      btn.title = 'ប្រើបានតែពេលដំណើរការក្នុង Google Apps Script';
    }
    syncSourceUI();
    pullLetterSheet(currentContentType());
  });

  let sidebarCollapsed = false;

  function toggleSidebar() {
    sidebarCollapsed = !sidebarCollapsed;
    applySidebarState();
    try { localStorage.setItem('sidebar_collapsed', sidebarCollapsed ? '1' : '0'); } catch (e) {}
  }

  function applySidebarState() {
    const sidebar = document.getElementById('app-sidebar');
    const mainContent = document.querySelector('.main-content');
    const icon = document.getElementById('sidebar-toggle-icon');
    if (!sidebar || !mainContent) return;

    sidebar.classList.toggle('sidebar-collapsed', sidebarCollapsed);
    mainContent.classList.toggle('main-content-expanded', sidebarCollapsed);

    if (icon) {
      icon.classList.toggle('fa-angles-left', !sidebarCollapsed);
      icon.classList.toggle('fa-angles-right', sidebarCollapsed);
    }
  }

  function restoreSidebarState() {
    try {
      const saved = localStorage.getItem('sidebar_collapsed');
      sidebarCollapsed = (saved === '1');
    } catch (e) {
      sidebarCollapsed = false;
    }
    applySidebarState();
  }

  function goToLetterForDonor(id) {
    if (!currentUser || currentUser.role !== 'Admin') return;
    syncSourceUI();
    switchTab('letter');
    populateLetterDonorSelect();
    const chk = document.getElementById(`donor_chk_${id}`);
    if (chk && !chk.checked) {
      chk.checked = true;
      handleDonorCheckboxChange(id, true);
    }
  }
</script>
